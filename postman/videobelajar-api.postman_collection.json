                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('semua kategori desain', () => d.forEach(c => pm.expect(c.category_slug).to.eql('desain')));",
                  "pm.test('harga terurut naik', () => { for (let i = 1; i < d.length; i++) pm.expect(Number(d[i].price)).to.be.at.least(Number(d[i-1].price)); });"
